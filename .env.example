# --- Database ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp_pos
DATABASE_URL=postgresql://erp:erp_dev_password@localhost:55432/erp_pos?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_PREFIX=api/v1
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=60
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
SUPER_ADMIN_EMAIL=admin@erp.local
SUPER_ADMIN_PASSWORD=ChangeMeNow!123
SEED_SHOP_CODE=HQ01
SEED_SHOP_NAME=Headquarters

# --- Object storage (MinIO in dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_password
S3_BUCKET=erp-pos
S3_FORCE_PATH_STYLE=true

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
